# Base PostgreSQL maintenance database URL; DB_NAME is composed separately.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# Application database name.
DB_NAME=bookmyshow
# JWT signing secret. Replace before deployment.
JWT_SECRET=bookmyshow-local-development-secret-please-replace
JWT_ISSUER=bookmyshow-api
JWT_AUDIENCE=bookmyshow-web
JWT_EXPIRES_SECONDS=1800
DEMO_OTP=1234
CORS_ORIGINS=http://localhost:4200
